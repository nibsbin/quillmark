{
  "name": "@quillmark/wasm",
  "version": "VERSION_PLACEHOLDER",
  "description": "WebAssembly bindings for Quillmark, a schema-driven document engine",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borb-sh/quillmark.git"
  },
  "files": [
    "core",
    "backends",
    "runtime",
    "CHANGELOG.md"
  ],
  "main": "./runtime/runtime.js",
  "module": "./runtime/runtime.js",
  "types": "./runtime/runtime.d.ts",
  "exports": {
    ".": {
      "types": "./runtime/runtime.d.ts",
      "import": "./runtime/runtime.js",
      "default": "./runtime/runtime.js"
    }
  },
  "imports": {
    "#quillmark-env": {
      "node": "./runtime/env-node.js",
      "default": "./runtime/env-web.js"
    }
  },
  "sideEffects": [
    "./runtime/runtime.js"
  ]
}
