// Auto-generated quillmark-helper package
// Version: {version}
//
// The Rust backend regenerates this file per render. Content fields, the
// document data and the schema address tables are all generated source text,
// so nothing here processes data at runtime.

/// Backend-generated schema address tree (`fields` for the main card, `cards`
/// keyed by kind): the schema pruned to the steps it offers, each node carrying
/// `props` and `item` where it admits a property or an index step, and a
/// matrix its `roster` and, when open, the `added` step.
#let _qm-meta = {meta_literal}

/// The address tree node `path` reaches, or `none` where it takes a step the
/// schema does not offer: a top-level field (`subject`), an array element
/// (`refs.2`), a container property (`classification.poc`,
/// `contact.address.city`), a matrix member (`qualifications.flight_cc`), or a
/// card address (`$cards.<kind>.<n>.<field>` with any of those suffixes). Each
/// step is gated on what the node it steps out of actually offers, so
/// `subject.0` and `subject.poc` are both rejected on a scalar `subject`. A
/// present-but-empty tree offers no step and so rejects every address.
#let _qm-node(path) = {
  let fields = _qm-meta.at("fields", default: (:))
  let cards = _qm-meta.at("cards", default: (:))
  let is-index(s) = s.match(regex("^[0-9]+$")) != none
  let is-id(s) = s.match(regex("^[a-z][a-z0-9_]*$")) != none
  // A digit takes the array element; any other segment a declared property,
  // else an open matrix's added item. A node offering none ends the walk, so a
  // step past a leaf is rejected.
  let walk(node, steps) = {
    for step in steps {
      let props = node.at("props", default: (:))
      if is-index(step) {
        if not ("item" in node) { return none }
        node = node.at("item")
      } else if step in props {
        node = props.at(step)
      } else if "added" in node and is-id(step) {
        node = node.at("added")
      } else {
        return none
      }
    }
    node
  }
  let parts = path.split(".")
  if parts.at(0) == "$cards" {
    if parts.len() < 4 { return none }
    let kind = parts.at(1)
    if not (kind in cards) { return none }
    if not is-index(parts.at(2)) { return none }
    return walk(cards.at(kind), parts.slice(3))
  }
  walk(fields, parts)
}

/// Whether `path` is a schema address: one `_qm-node` reaches.
#let _qm-known-path(path) = _qm-node(path) != none

/// Emit an unsigned form field: a clickable AcroForm widget on PDF output, the
/// same invisible layout space on SVG/PNG. `value` is forwarded verbatim and
/// the Rust adapter maps it per `type` — a string for `"text"` (blank ⇒ no
/// `/V`), nothing at all for `"signature"`. `field` keys the widget's region on a schema
/// address and is region-only: the `/T` widget name stays `name`, and omitting
/// it leaves the widget with no region for a consumer to route to.
/// `font`/`size`/`align` set the type the *viewer* draws the value in;
/// `size: auto` refits as the user types, and `align` is the only way to pin a
/// value to an edge of a box sized for the longest plausible value. Parameters
/// and examples: `docs/quills/typst-backend.md`.
///
/// `<__qm_field__>` and `kind: "__qm_field__"` are reserved for this hand-off.
/// This emits a `metadata` element, so a plate or package reading its own
/// config through an unfiltered `query(metadata)` must query by a dedicated
/// label or filter on a key it owns, or it will read this field's metadata by
/// accident.
#let form-field(
  name,
  type: "text",
  value: none,
  multiline: false,
  width: 200pt,
  height: 20pt,
  field: none,
  font: "helvetica",
  size: auto,
  align: "left",
) = {
  assert(std.type(name) == str,
    message: "form-field: name must be a string, got " + repr(std.type(name)))
  assert(name.match(regex("^[A-Za-z0-9_.]+$")) != none,
    message: "form-field: name must match [A-Za-z0-9_.]+, got " + repr(name))
  assert(type in ("text", "signature"),
    message: "form-field: type must be one of text/signature, got " + repr(type))
  assert(field == none or std.type(field) == str,
    message: "form-field: field must be a string or none, got " + repr(std.type(field)))
  assert(field == none or _qm-known-path(field),
    message: "form-field: " + repr(field) + " is not a schema field address; expected a field name, an array element like \"refs.2\", a container property like \"classification.poc\", or a card path composed from the card's $path prefix")
  assert(font in ("helvetica", "times", "courier"),
    message: "form-field: font must be one of helvetica/times/courier, got " + repr(font))
  assert(align in ("left", "center", "right"),
    message: "form-field: align must be one of left/center/right, got " + repr(align))
  assert(type == "text" or (font == "helvetica" and size == auto and align == "left"),
    message: "form-field: font/size/align apply to text fields only, got type " + repr(type))
  let abs-pt(field, l) = {
    let r = repr(l)
    assert(not (r.contains("em") or r.ends-with("%")),
      message: "form-field: " + field + " must be an absolute length, got " + r)
    l / 1pt
  }
  // Guarded rather than passed through: `0pt` would reach the PDF as the `0 Tf`
  // that means auto-size, quietly granting the opposite of an explicit size.
  let size-pt = if size == auto { none } else { abs-pt("size", size) }
  assert(size-pt == none or size-pt > 0,
    message: "form-field: size must be a positive length or auto, got " + repr(size))
  // The backend reads this tag's position as the widget's top-left, and only
  // the box body's origin is that point in every layout context: a tag beside
  // the box sits on the line's baseline inline, and at the flow cursor's left
  // edge in a block.
  box(width: width, height: height, stroke: none, fill: none)[#metadata((
    kind: "__qm_field__",
    name: name,
    field-type: type,
    value: value,
    multiline: multiline,
    width: abs-pt("width", width),
    height: abs-pt("height", height),
    field: field,
    font: font,
    size: size-pt,
    align: align,
  ))<__qm_field__>]
}

/// Emit an unsigned signature field: `form-field` with `type: "signature"`,
/// which carries no value. `field` forwards the region binding.
#let signature-field(name, width: 200pt, height: 50pt, field: none) = form-field(
  name,
  type: "signature",
  width: width,
  height: height,
  field: field,
)

/// Claim the ink `body` draws for schema field `field`, so `session.regions()`
/// lists it and `session.fieldAt(..)` resolves a click on it — for a
/// presentation the plate composes rather than reads straight off `data`: a
/// banner keyed on `data.classification`, a package-built address block, a
/// computed table. Layout-neutral: `body` is returned untouched, bracketed by
/// two invisible `metadata` markers.
///
/// The claim is a **fallback**, not an override: ink already tracked to a field
/// keeps that field, so wrapping only ever adds a region and never moves one.
/// Each *call* claims independently, so a wrapper invoked once per card with
/// `card.at("$path") + "$body"` yields one region per card.
///
/// `<__qm_region__>` and `kind: "__qm_region__"` are reserved for this
/// hand-off; the `query(metadata)` caveat on `form-field` applies here too.
#let field-region(field, body) = {
  assert(std.type(field) == str,
    message: "field-region: field must be a string, got " + repr(std.type(field)))
  assert(_qm-known-path(field),
    message: "field-region: " + repr(field) + " is not a schema field address; expected a field name, an array element like \"refs.2\", a container property like \"classification.poc\", or a card path composed from the card's $path prefix")
  [#metadata((kind: "__qm_region__", field: field, close: false))<__qm_region__>]
  body
  [#metadata((kind: "__qm_region__", field: field, close: true))<__qm_region__>]
}

/// The plate's element renderers, keyed by element name: each a function of
/// the element's attribute dictionary and its body. A plate registers one
/// anywhere in the plate, since the dispatcher reads the registry's final
/// value: `#elements.update(e => e + (stamp: (attrs, body) => text(fill: red, body)))`.
#let elements = state("quillmark-elements", (:))

/// Element `name` around `body`, which the engine calls for each element in
/// the content: the plate's renderer under `elements`, else the built-in
/// `keep`, which keeps its body on one page, else `body` as it stands, behind
/// a `<__qm_element__>` marker naming the element and the registered names,
/// which the backend reports as `typst::unregistered_element`.
#let _qm-element(name, attrs, body) = context {
  let registry = elements.final()
  let render = registry.at(name, default: none)
  if render != none {
    render(attrs, body)
  } else if name == "keep" {
    block(breakable: false, body)
  } else {
    let registered = registry.keys().filter(k => registry.at(k) != none)
    [#metadata((kind: "__qm_element__", name: name, registered: registered))<__qm_element__>]
    body
  }
}

/// The plate's task item renderer: a function of whether the item is done and
/// its body, registered anywhere in the plate since the dispatcher reads the
/// final value: `#tasks.update(_ => (done, body) => if done { strike(body) } else { body })`.
#let tasks = state("quillmark-tasks", none)

/// Task item `body`, done or not, which the engine calls for each task list
/// item in the content: the plate's renderer under `tasks`, else a box ahead
/// of `body`, ticked where `done`. Drawn, so it needs no glyph from the font.
#let _qm-task(done, body) = context {
  let render = tasks.final()
  if render != none {
    render(done, body)
  } else {
    let s = 0.7em
    box(width: s, height: s, stroke: 0.06em, baseline: 0.05em, if done {
      place(curve(
        stroke: 0.1em,
        curve.move((0.18 * s, 0.52 * s)),
        curve.line((0.42 * s, 0.76 * s)),
        curve.line((0.84 * s, 0.22 * s)),
      ))
    })
    h(0.4em)
    body
  }
}

// Per-field content, generated by the Rust backend: one markup block
// (`#let _qm_cN = [ .. ]`) per content field, `richtext[]` element and card
// content field present in the document data. Every glyph a block places
// carries its own syntax node's span, which `session.regions()` reads
// placement geometry back from.
{content_blocks}

/// Document data as a dictionary: a backend-generated Typst literal. Every
/// value is at its **native** Typst type — a present `date`/`datetime` is a
/// `datetime(..)` (blank ⇒ `none`), a number an int or float, a typed
/// dictionary a dict — save the content types, whose authored text is a
/// canonical rendering and so reference their `_qm_cN` markup block. The rule
/// holds at every depth. `$cards` carry their per-kind-ordinal `$path` prefix.
/// Every dictionary with a field that has ink carries it under `$ink`, read
/// with `ink`, beside its address prefix as `$path`.
#let data = {data_literal}

/// The printable twin of a dictionary's fields: `ink(data).subject`,
/// `ink(card).topic`, `ink(row).org`. Each value's glyphs are born in this
/// generated file, so they keep their schema address through a function
/// parameter, a loop variable, a destructuring or a package, where a plate's
/// own `#row.org` keeps it only as a direct read.
///
/// A string, number or boolean is the content `#<value>` prints; a content
/// field is its markup block; a date is its default `display`, and
/// `display(dict, "due", ..)` formats it; an array is its elements' ink; a
/// field at `none` has `none`. A field that is itself a dictionary has no ink:
/// it carries its own. Compute with the dictionary, print its ink.
#let ink(fields) = {
  assert(std.type(fields) == dictionary,
    message: "ink: expected data, a card or a typed dictionary, got " + repr(std.type(fields)))
  fields.at("$ink", default: (:))
}

/// Backend-generated content projection for every **present** `date`/`datetime`
/// field, keyed by schema address. Each value is a `_qm_dN` closure block, so
/// the ink it places is born in generated source.
#let _qm-display = {display_literal}

/// A date field's **content** projection, formatted with Typst's own
/// `datetime.display` patterns. Where `data.<field>` carries the native
/// `datetime` (arithmetic, comparison, `.year()`, a package that wants a real
/// date), this places rendered ink whose glyphs carry a region keyed on the
/// field, so a date formatted through a `#let` binding, a loop variable, or a
/// vendored package stays click-to-edit. Use `data.<field>.display(..)` where a
/// plain `str` is wanted and no region is.
///
/// `field` is the date's schema address (compose a card field from the card's
/// `$path`: `display(card.at("$path") + "on", "[year]")`), or a dictionary
/// followed by the date's key within it: `display(row, "due", "[year]")`, the
/// form for a row or card reached through a loop or a function. An address the
/// schema does not have is a compile error; a blank date, or a known address
/// carrying no date, returns `none`, so a `== none` fallback still fires.
#let display(field, ..args) = {
  if std.type(field) == dictionary {
    assert("$path" in field,
      message: "display: this dictionary carries no $path; pass data, a card, or the typed dictionary that declares the date")
    let pos = args.pos()
    assert(pos.len() > 0 and std.type(pos.at(0)) == str,
      message: "display: a dictionary is followed by the date's key, as in display(row, \"due\", \"[year]\")")
    return display(field.at("$path") + pos.at(0), ..pos.slice(1), ..args.named())
  }
  assert(std.type(field) == str,
    message: "display: field must be a schema address string or a dictionary, got " + repr(std.type(field)))
  assert(_qm-known-path(field),
    message: "display: " + repr(field) + " is not a schema field address; expected a field name, an array element like \"refs.2\", a container property like \"classification.poc\", or a card path composed from the card's $path prefix")
  let render = _qm-display.at(field, default: none)
  if render != none { render(..args) }
}

/// A matrix's rows, the vocabulary a plate prints: every roster member in
/// roster order, then each item the value adds, in id order. A row is
/// `(id, title, held, value, path)`. `held` is the member's presence, `value`
/// its dictionary of columns (`none` where unheld), and `path` its address,
/// which `field-region` claims. A roster member's `title` is the roster's; an
/// added item's is its own cell, whose ink `ink(row.value).title` places.
///
/// `dict` is data, a card or the typed dictionary declaring the matrix, and
/// `key` the matrix's name within it: `roster(data, "qualifications")`,
/// `roster(card, "qualifications")`, `roster(row, "quals")`. The address comes
/// from the dictionary's `$path`, which every dictionary declaring a matrix
/// carries. An optional matrix left unanswered is `none`, and holds nothing.
#let roster(dict, key) = {
  assert(std.type(dict) == dictionary,
    message: "roster: expected data, a card or a typed dictionary, got " + repr(std.type(dict)))
  assert("$path" in dict,
    message: "roster: this dictionary carries no $path; pass data, a card, or the typed dictionary that declares the matrix")
  let path = dict.at("$path") + key
  let node = _qm-node(path)
  assert(node != none and "roster" in node,
    message: "roster: " + repr(path) + " is not a matrix field address")
  let held = dict.at(key, default: none)
  if held == none { held = (:) }
  let ids = node.roster.map(((id, _)) => id)
  let rows = node.roster.map(((id, title)) => {
    let value = held.at(id, default: none)
    (id: id, title: title, held: value != none, value: value, path: path + "." + id)
  })
  for (id, value) in held {
    if id not in ids {
      rows.push((id: id, title: value.title, held: true, value: value, path: path + "." + id))
    }
  }
  rows
}
