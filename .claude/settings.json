{
  "permissions": {
    "allow": [
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo doc:*)",
      "Bash(RUSTDOCFLAGS=-Dwarnings cargo doc:*)",
      "Bash(cargo fetch:*)",
      "Bash(node scripts/check-canon.mjs)",
      "Bash(./scripts/build-wasm.sh --ci)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-cargo-fmt.sh" } ] }
    ]
  }
}
